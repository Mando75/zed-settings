// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "sticky_scroll": {
    "enabled": true
  },
  "inlay_hints": {
    "show_type_hints": false,
    "show_value_hints": true,
    "enabled": false
  },
  "code_lens": "menu",
  "document_symbols": "off",
  "semantic_tokens": "combined",
  "colorize_brackets": true,
  "snippet_sort_order": "top",
  "cli_default_open_behavior": "existing_window",
  "file_finder": {
    "include_ignored": "smart"
  },
  "search": {
    "include_ignored": false
  },
  "context_servers": {
    "mcp-server-playwright": {
      "enabled": true,
      "remote": false,
      "settings": {}
    }
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "project_panel": {
    "dock": "left",
    "auto_reveal_entries": false
  },
  "git_panel": {
    "tree_view": true,
    "dock": "right"
  },
  "git": {
    "inline_blame": {
      "enabled": true
    }
  },

  // Status bar settings
  // https://zed.dev/docs/reference/all-settings#status-bar
  "status_bar": {
    "show_active_file": false,
    "experimental.show": false
  },

  // Cursor shape: bar, block, underline, hollow
  // https://zed.dev/docs/reference/all-settings#cursor-shape
  "cursor_shape": "bar",

  // Whether the cursor blinks
  // https://zed.dev/docs/reference/all-settings#cursor-blink
  "cursor_blink": true,

  // Use macOS native window tabs
  // https://zed.dev/docs/reference/all-settings#use-system-tabs
  "use_system_window_tabs": true,
  // Show whitespace characters: all, selection, none, boundary
  // https://zed.dev/docs/reference/all-settings#show-whitespaces
  "show_whitespaces": "all",
  // Gutter settings
  // https://zed.dev/docs/reference/all-settings#gutter
  "gutter": {
    "line_numbers": true
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "left"
  },
  "debugger": {
    "dock": "left"
  },
  "terminal": {
    "dock": "right"
  },
  "toolbar": {
    "code_actions": true
  },
  "preview_tabs": {
    "enabled": false
  },
  "agent": {
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini"
    },
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_deny": [],
          "always_allow": [
            {
              "pattern": "^pnpm"
            },
            {
              "pattern": "^vitest"
            },
            {
              "pattern": "^oxlint"
            },
            {
              "pattern": "^oxfmt"
            },
            {
              "pattern": "^pnpx"
            }
          ]
        }
      }
    },
    "dock": "right",
    "favorite_models": [],
    "notify_when_agent_waiting": "never",
    "model_parameters": []
  },
  "edit_predictions": {
    "mode": "subtle",
    "allow_data_collection": "no",
    "copilot": {
      "enable_next_edit_suggestions": true
    },
    "provider": "copilot"
  },
  "calls": {
    "mute_on_join": false
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "sonnet[1m]"
      },
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    }
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "icon_theme": "Catppuccin Frappé",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Catppuccin Macchiato"
  },
  // Whether to show signature help after completion or bracket pair inserted
  // https://zed.dev/docs/reference/all-settings#show-signature-help-after-edits
  "show_signature_help_after_edits": false,

  // Show method signatures when inside parentheses
  // https://zed.dev/docs/reference/all-settings#auto-signature-help
  "auto_signature_help": false,

  // Hide variable values in private files (e.g., .env, .pem)
  // https://zed.dev/docs/reference/all-settings#redact-private-values
  "redact_private_values": true,

  // LSP
  "lsp": {
    // OXFMT & LINT
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": true,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmg.configPath": null,
          "run": "onSave"
        }
      }
    }
  },
  "languages": {
    "OpenFGA": {
      "show_edit_predictions": true
    },
    "CSS": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "HTML": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JavaScript": {
      "format_on_save": "on",
      "language_servers": ["!typescript-language-server", "vtsls", "..."],
      "prettier": {
        "allowed": false
      },
      "code_actions_on_format": {
        "source.addMissingImports.ts": true,
        "source.organizeImports": true
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        },
        {
          "code_action": "source.fixAll.oxc"
        }
      ]
    },
    "JSON": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSON5": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSONC": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Less": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Markdown": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "MDX": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TypeScript": {
      "colorize_brackets": true,
      "inlay_hints": {
        "enabled": false,
        "show_background": false
      },
      "format_on_save": "on",
      "language_servers": ["!typescript-language-server", "vtsls", "..."],
      "prettier": {
        "allowed": false
      },
      "code_actions_on_format": {
        "source.addMissingImports.ts": true,
        "source.organizeImports": true
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TSX": {
      "colorize_brackets": true,
      "inlay_hints": {
        "enabled": true
      },
      "format_on_save": "on",
      "language_servers": ["!typescript-language-server", "vtsls", "..."],
      "prettier": {
        "allowed": false
      },
      "code_actions_on_format": {
        "source.addMissingImports.ts": true,
        "source.organizeImports": true
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "YAML": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    }
  }
}
