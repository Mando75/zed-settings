{
  "Insert Effect Service": {
    "prefix": "ets",
    "body": [
      "import { Context, Effect, Layer } from 'effect';",
      "",
      "export class ${1:ServiceName} extends Context.Service<${1:ServiceName}>()('${2:AppName}/${1:ServiceName}', {",
      "  make: Effect.gen(function* () {",
      "    $0",
      "  })",
      "}) {",
      "  static readonly layer = Layer.effect(this, this.make);",
      "}",
      "",
      "export type ${1:ServiceName}Shape = ${1:ServiceName}['Service'];"
    ]
  }
}
